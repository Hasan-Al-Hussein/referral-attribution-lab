# Public Branch test-key configuration for a custom native build.
NATIVE_SDK_BUILD=0
# Set for local config/prebuild. EAS profiles set this per platform.
NATIVE_BUILD_PLATFORM=android
# Development and preview use test; production uses live in eas.json.
BRANCH_ENVIRONMENT=test
EXPO_PUBLIC_BRANCH_TEST_KEY=key_test_REPLACE_ME
# Optional in test mode. When omitted, the public test key also fills the
# plugin's structurally required apiKey slot; testApiKey remains authoritative.
EXPO_PUBLIC_BRANCH_LIVE_KEY=key_live_REPLACE_ME
# Backward-compatible alias: key_test_* in test mode or key_live_* in live mode.
# EXPO_PUBLIC_BRANCH_KEY=key_test_REPLACE_ME
EXPO_PUBLIC_BRANCH_DOMAIN=your-app.test-app.link
EXPO_PUBLIC_BRANCH_ALTERNATE_DOMAIN=your-app-alternate.test-app.link

# Local paths. EAS file variables inject temporary worker paths with these names.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
EAS_PROJECT_ID=
