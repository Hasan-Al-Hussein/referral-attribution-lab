{
  "name": "referral-attribution-lab",
  "version": "1.0.0",
  "description": "A production-shaped React Native case study for reliable referral attribution across direct and deferred deep links.",
  "private": true,
  "license": "MIT",
  "author": "Hasan Al Hussein",
  "homepage": "https://hasan-al-hussein.github.io/referral-attribution-lab/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hasan-Al-Hussein/referral-attribution-lab.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "deep-linking",
    "referral-attribution",
    "branch",
    "firebase-analytics",
    "reliability-engineering"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-native.mjs android run",
    "ios": "node scripts/run-native.mjs ios run",
    "native:prebuild:android": "node scripts/run-native.mjs android prebuild",
    "native:prebuild:ios": "node scripts/run-native.mjs ios prebuild",
    "native:verify:android": "node scripts/verify-native-prebuild.mjs android",
    "native:verify:ios": "node scripts/verify-native-prebuild.mjs ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@config-plugins/react-native-branch": "13.0.1",
    "@expo/env": "^2.4.2",
    "@expo/plist": "^0.7.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "26.0.0",
    "@react-native-firebase/app": "26.0.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~56.0.18",
    "expo-build-properties": "~56.0.24",
    "expo-clipboard": "~56.0.4",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.7",
    "expo-linear-gradient": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-branch": "6.10.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "56.0.4",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-branch",
          "@config-plugins/react-native-branch"
        ]
      }
    }
  }
}
